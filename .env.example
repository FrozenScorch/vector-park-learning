# Required for Level 0.
NPS_API_KEY=your-nps-key

# Required for Level 1+.
# Choose one provider: nvidia, deepseek, ollama, or openai-compatible.
LLM_PROVIDER=nvidia
LLM_MODEL=google/gemma-4-31b-it
# Optional tuning knobs.
# LLM_MAX_TOKENS=2048
# LLM_TOP_P=0.95

# NVIDIA NIM option.
NVIDIA_API_KEY=your-nvidia-api-key
# Set true only when you intentionally want model reasoning traces/behavior.
NVIDIA_ENABLE_THINKING=false

# DeepSeek option.
# LLM_PROVIDER=deepseek
# LLM_MODEL=deepseek-v4-flash
# DEEPSEEK_API_KEY=your-deepseek-api-key
# DEEPSEEK_THINKING=disabled

# Local Ollama option.
# LLM_PROVIDER=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1

# Generic OpenAI-compatible option.
# LLM_PROVIDER=openai-compatible
# LLM_BASE_URL=http://localhost:11434/v1
# LLM_API_KEY=local-or-provider-key

# Required starting in Level 3.
DATABASE_URL=postgresql://postgres:dev@localhost:5432/fieldguide
